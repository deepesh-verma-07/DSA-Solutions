class Solution {
private:
    bool dfsCheck(int node, vector<vector<int>>& graph, int vis[], int pathVis[]) {
        vis[node] = 1;
        pathVis[node] = 1;
        
        // traverse for adjacent nodes
        for(auto it : graph[node]) {
            // when the node is not visited
            if(!vis[it]) {
                if(dfsCheck(it, graph, vis, pathVis) == true) {
                    return true;
                }
            }
            // if the node has been previously visited
            // but it has to be visited on the same path (cycle found)
            else if(pathVis[it]) {
                return true;
            }
        }
        
        pathVis[node] = 0; // backtrack
        return false;
    }

public:
    // Function to detect cycle in a directed graph.
    bool isCyclic(int V, vector<vector<int>>& graph) {
        int vis[V] = {0};
        int pathVis[V] = {0};
        
        for(int i = 0; i < V; i++) {
            if(!vis[i]) {
                if(dfsCheck(i, graph, vis, pathVis) == true) {
                    return true;
                }
            }
        }
        return false;
    }
};
